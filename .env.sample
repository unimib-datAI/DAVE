
# Sample .env file for DAVE docker-compose.yml
# UI Configuration
ACCESS_USERNAME=admin
ACCESS_PASSWORD=password
API_BASE_URI=http://documents:3001/api
API_USERNAME=admin
API_PASSWORD=password
NEXTAUTH_SECRET=your_nextauth_secret_change_this_to_random_string
NEXTAUTH_URL=http://127.0.0.1:3000/dave/api/auth
NEXT_PUBLIC_BASE_PATH=/dave
NEXT_PUBLIC_FULL_PATH=http://127.0.0.1:3000/dave
API_LLM=http://text-generation:7862
API_INDEXER=http://qavectorizer:7863
VARIANT=default
LISTEN_UI=3000
ELASTIC_INDEX=dave

# Keycloak Configuration (optional)
USE_KEYCLOAK=false
KEYCLOAK_ID=dave_client
KEYCLOAK_SECRET=your_keycloak_secret
KEYCLOAK_ISSUER=http://keycloak:8080/realms/DAVE
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PORT=8080
KEYCLOAK_DB_PASSWORD=keycloak

# General
RESTART_POLICY=unless-stopped

# MongoDB Configuration
MONGO_ROOT_PASSWORD=mongo_root_password
MONGO_PASSWORD=mongo_password
MONGO=mongodb://root:mongo_root_password@mongo:27017/dave?authSource=admin

# Documents Service
DOCS_PORT=3001
ENABLE_AUTH=true

# Text Generation Service
TEXT_GENERATION=http://text-generation:8000
TEXT_GENERATION_ADDR=http://text-generation:8000
TEXT_GENERATION_KEY=your-key
MODEL_NAME=phi4-mini
TEXT_GENERATION_GPU_LAYERS=35
HOST=0.0.0.0

# QA Vectorizer Service
HOST_BASE_URL=http://0.0.0.0
INDEXER_SERVER_PORT=7863
QAVECTORIZER_ADDR=7863
API_INDEXER=http://qavectorizer:7863
CHROMA_PORT=8000
# Retrieval-trained multilingual model (768 dims, like the index mapping).
# Changing it on an existing install requires re-indexing every document:
# vectors from different models are not comparable.
SENTENCE_TRANSFORMER_EMBEDDING_MODEL=ibm-granite/granite-embedding-311m-multilingual-r2
SENTENCE_TRANSFORMER_DEVICE=cuda
# Cross-encoder that reranks retrieved chunks; leave empty to disable it
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
OGG2NAME_INDEX=ogg2name
QAVECTORIZER_ADDR=7863

# Annotation Services (optional - set if you have these services)
ANONYMIZATION_ENDPOINT=
ANNOTATION_SPACYNER_URL=
ANNOTATION_BLINK_URL=
ANNOTATION_INDEXER_URL=
ANNOTATION_NILPREDICTION_URL=
ANNOTATION_NILCLUSTER_URL=
ANNOTATION_CONSOLIDATION_URL=

# Upload jobs processed at the same time (each one walks its files in order)
UPLOAD_JOB_CONCURRENCY=2

# RAG retrieval tuning (optional - these are the defaults)
# Chunks returned per query, and how many may come from the same document
RAG_TOP_K=10
RAG_MAX_CHUNKS_PER_DOC=5
# Reciprocal Rank Fusion of the dense and full-text rankings
RAG_RRF_K=60
RAG_RRF_DENSE_WEIGHT=1
RAG_RRF_FULLTEXT_WEIGHT=1
# Fused chunks sent to the reranker (0 disables reranking)
RAG_RERANK_POOL=50
# Boost of a query match on the document title
RAG_NAME_BOOST=2
# Chunking, applied to documents indexed from now on
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=100
